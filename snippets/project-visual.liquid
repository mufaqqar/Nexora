<div class="project-visual {{ class | default: '' }}">
  {% if image != blank %}
    {{ image | image_url: width: 1000 | image_tag: loading: loading | default: 'lazy', widths: '400,600,800,1000', sizes: '(min-width: 990px) 50vw, 100vw', class: 'project-visual__image', alt: image.alt | escape }}
  {% else %}
    <div class="device-art" aria-hidden="true">
      <div class="device-art__glow"></div>
      <div class="device-art__ring"></div>
      <div class="device-art__device">
        <div class="device-art__screen">
          <span>N</span>
        </div>
      </div>
      <div class="device-art__floor"></div>
    </div>
  {% endif %}
</div>
