{% assign funded = product.metafields.project.funded_percent.value | default: 46 %}
{% assign current = product.metafields.project.current_amount.value | default: 46000 %}
{% assign target = product.metafields.project.target_amount.value | default: 100000 %}
{% assign investors = product.metafields.project.investors.value | default: 28 %}
{% assign category = product.metafields.project.category.value | default: 'Technologie' %}

<article class="project-card">
  <a class="project-card__media" href="{{ product.url }}">
    {% render 'project-visual', image: product.featured_image, loading: 'lazy' %}
    
  </a>

  <div class="project-card__body">
    <div class="project-card__top">
        <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
       <span class="project-card__category">{{ category }}</span>
    </div>

    {% if product.description != blank %}
      <p class="project-card__description">{{ product.description | strip_html | truncate: 105 }}</p>
    {% endif %}

    <div class="project-card__stats">
      <div>
        <strong>{{ funded }}%</strong>
        <span>Financé</span>
      </div>
      <div>
        <strong>{{ current | money_without_trailing_zeros }}</strong>
        <span>Collecté / {{ target | money_without_trailing_zeros }}</span>
      </div>
      <div>
        <strong>{{ investors }}</strong>
        <span>Investisseurs</span>
      </div>
    </div>

    <div class="progress">
      <span style="width: {{ funded }}%"></span>
    </div>
 </div>
    <a class="project__button--secondary" href="{{ product.url }}">
      Voir le projet
    </a>
 
</article>
