<section class="section section--compact">
  <div class="container">
    <div class="value-grid">
      {% for block in section.blocks %}
        <div class="value-item reveal" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
            <div class="value-item__icon">
              {{
                block.settings.icon
                | image_url: width: 100
                | image_tag:
                  loading: 'lazy',
                  widths: '50,75,100',
                  sizes: '50px',
                  class: 'value-item__icon-image',
                  alt: block.settings.heading
              }}
            </div>
          {% endif %}
          <div>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Values",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Curated opportunities"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Projects carefully vetted with a rigorous approach."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Curated opportunities",
            "text": "Projects carefully vetted with a rigorous approach."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Long-term vision",
            "text": "We invest in the companies shaping tomorrow."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Transparency",
            "text": "Clear information to help you make better decisions."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Simplified access",
            "text": "A digital experience designed to focus on what matters."
          }
        }
      ]
    }
  ]
}
{% endschema %}
