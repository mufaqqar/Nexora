<section class="section section--compact">
  <div class="container">
    <div class="value-grid">
      {% for block in section.blocks %}
        <div class="value-item reveal" {{ block.shopify_attributes }}>
          <span class="value-item__number">{{ forloop.index | prepend: '0' }}</span>
          <div>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Valeurs",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "value",
      "name": "Valeur",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Opportunités sélectionnées"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "Des projets analysés avec une approche rigoureuse."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valeurs",
      "blocks": [
        {"type": "value", "settings": {"heading": "Opportunités sélectionnées", "text": "Des projets analysés avec une approche rigoureuse."}},
        {"type": "value", "settings": {"heading": "Vision long terme", "text": "Nous investissons dans les entreprises qui façonnent demain."}},
        {"type": "value", "settings": {"heading": "Transparence", "text": "Des informations claires pour prendre de meilleures décisions."}},
        {"type": "value", "settings": {"heading": "Accès simplifié", "text": "Une expérience digitale pensée pour aller à l'essentiel."}}
      ]
    }
  ]
}
{% endschema %}
