<section class="section">
  <div class="container">
    <div class="cta-panel">

      <div class="cta-panel__content">
        {% comment %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endcomment %}

        <h2>{{ section.settings.heading }}</h2>

        <p>{{ section.settings.text }}</p>

        {% if section.settings.button_label != blank %}
          <a
            class="button"
            href="{{ section.settings.button_link | default: routes.collections_url }}"
          >
            {{ section.settings.button_label }}
            {% render 'icon-arrow' %}
          </a>
        {% endif %}
      </div>

      <div class="cta-panel__art">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400,600,800,1000',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'cta-panel__image',
              alt: section.settings.image.alt
          }}
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA investissement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "NEXORA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Commencez à investir dès aujourd'hui."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Découvrez les projets actuellement ouverts aux investisseurs."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Voir les projets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "CTA investissement"
    }
  ]
}
{% endschema %}