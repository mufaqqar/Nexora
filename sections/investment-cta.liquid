<section class="section">
  <div class="container">
    <div class="cta-panel">

      <div class="cta-panel__content">
        {% comment %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endcomment %}

        <h2>{{ section.settings.heading }}</h2>

        <p>{{ section.settings.text }}</p>

        {% if section.settings.button_label != blank %}
          <a
            class="button"
            href="{{ section.settings.button_link | default: routes.collections_url }}"
          >
            {{ section.settings.button_label }}
            {% render 'icon-arrow' %}
          </a>
        {% endif %}
      </div>

      <div class="cta-panel__art">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 250
            | image_tag:
              loading: 'lazy',
              widths: '250,400,600,800,1000',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'cta-panel__image',
              alt: section.settings.image.alt
          }}
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Investment CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEXORA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Start investing today."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover the opportunities currently available to investors."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "View projects"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Investment CTA"
    }
  ]
}
{% endschema %}