<section class="section">
  <div class="container">
    <div class="cta-panel">

      <div class="cta-panel__content">
        <h2>{{ section.settings.heading }}</h2>

        <div class="cta-panel__text">
          {{ section.settings.text }}
        </div>

        {% if section.settings.button_label != blank %}
          <a
            class="button"
            href="{{ section.settings.button_link | default: routes.collections_url }}"
          >
            {{ section.settings.button_label }}
            {% render 'icon-arrow' %}
          </a>
        {% endif %}
      </div>

      {% if section.settings.image != blank %}
        <div class="cta-panel__art reveal reveal--delay">
          {% render 'project-visual',
            image: section.settings.image,
            loading: 'lazy'
          %}
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Introduction à propos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Commencez à investir dès aujourd'hui"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Rejoignez Nexora et investissez dans les entreprises qui construiront le futur.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Créer un compte"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Introduction à propos"
    }
  ]
}
{% endschema %}