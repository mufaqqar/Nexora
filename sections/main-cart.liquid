{% if cart.item_count > 0 %}

  <section class="section cart-section">
    <div class="container cart-container">
      <div class="page-heading">
        <h1>Votre panier</h1>
        <p>{{ cart.item_count }} projet(s) à investir pour un montant total de {{ cart.total_price | money }}.</p>
      </div>

      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-layout">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <a class="cart-item__media" href="{{ item.url }}">
                {% if item.image != blank %}
                  {{
                    item.image
                    | image_url: width: 240
                    | image_tag:
                      loading: 'lazy',
                      widths: '120,180,240',
                      sizes: '96px',
                      class: 'cart-item__image',
                      alt: item.title
                  }}
                {% else %}
                  <span class="cart-item__placeholder">{{ item.product.title | slice: 0, 1 }}</span>
                {% endif %}
              </a>

              <div class="cart-item__info">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              </div>

              <div class="cart-item__actions">
                <label class="cart-item__label" for="updates-{{ item.key }}">Quantité</label>
                <input
                  class="cart-item__qty"
                  id="updates-{{ item.key }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantité"
                >
                <a class="cart-item__remove" href="{{ item.url_to_remove }}">Supprimer</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <aside class="cart-summary">
          <h2>Résumé</h2>
          <div class="cart-summary__row">
            <span>Sous-total</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <div class="cart-summary__row">
            <span>Frais</span>
            <strong>Inclus lors du paiement</strong>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>Total</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>

          <button type="submit" name="checkout" class="button button--wide" data-cart-checkout>
            Procéder au paiement
          </button>
          <button type="submit" name="update" class="cart-summary__update">
            Mettre à jour les quantités
          </button>
        </aside>
      </form>
    </div>
  </section>

{% else %}

  <section class="section">
    <div class="container empty-state">
      <p class="eyebrow">NEXORA</p>
      <h1>Votre panier est vide</h1>
      <p>Découvrez les projets actuellement ouverts aux investisseurs.</p>
      <a class="button" href="{{ routes.collections_url }}/projects">Voir tous les projets</a>
    </div>
  </section>

{% endif %}

{% schema %}
{
  "name": "Panier",
  "settings": []
}
{% endschema %}