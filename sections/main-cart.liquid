{% assign platform_fee_rate = 2 %}{% assign fee_amount = cart.total_price | times: platform_fee_rate | divided_by: 100 %}{% assign grand_total = cart.total_price | plus: fee_amount %}{% if cart.item_count > 0 %}

  <section class="section cart-section">
    <div class="container cart-container">
      <div class="page-heading">
        <h1>Votre panier</h1>
        <p>{{ cart.item_count }} projet(s) à investir pour un montant total de {{ grand_total | money }}.</p>
      </div>

      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-layout cart-layout--summary">
        <aside class="cart-summary">
          <h2>Résumé</h2>
          <div class="cart-summary__row">
            <span>Sous-total</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <div class="cart-summary__row">
            <span>Frais de plateforme ({{ platform_fee_rate }}%)</span>
            <strong>{{ fee_amount | money }}</strong>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>Total</span>
            <strong>{{ grand_total | money }}</strong>
          </div>

          <button type="submit" name="checkout" class="button button--wide" data-cart-checkout>
            Procéder au paiement
          </button>
          <button type="button" class="cart-summary__update" data-cart-clear>
            Vider le panier
          </button>
        </aside>
      </form>
    </div>
  </section>

{% else %}

  <section class="section">
    <div class="container empty-state">
      <p class="eyebrow">NEXORA</p>
      <h1>Votre panier est vide</h1>
      <p>Découvrez les projets actuellement ouverts aux investisseurs.</p>
      <a class="button" href="{{ routes.collections_url }}/projects">Voir tous les projets</a>
    </div>
  </section>

{% endif %}

{% schema %}
{
  "name": "Panier",
  "settings": []
}
{% endschema %}
