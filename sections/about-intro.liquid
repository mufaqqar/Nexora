<section class="section about-intro">
  <div class="container about-intro__grid">
    <div class="about-intro__content reveal">
      {% comment %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endcomment %}
      <h1>{{ section.settings.heading }}</h1>
      <div class="richtext">{{ section.settings.text }}</div>
    </div>
    <div class="about-intro__visual reveal reveal--delay">
      {% render 'project-visual', image: section.settings.image, loading: 'lazy' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ABOUT NEXORA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "About Nexora"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Nexora connects investors with ambitious companies that are developing the technologies, services, and infrastructure of the future.</p><p>Our goal is to make access to opportunities simpler, more transparent, and more human.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "About introduction"
    }
  ]
}
{% endschema %}
