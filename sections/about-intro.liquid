<section class="section about-intro">
  <div class="container about-intro__grid">
    <div class="about-intro__content reveal">
      {% comment %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endcomment %}
      <h1>{{ section.settings.heading }}</h1>
      <div class="richtext">{{ section.settings.text }}</div>
    </div>
    <div class="about-intro__visual reveal reveal--delay">
      {% render 'project-visual', image: section.settings.image, loading: 'lazy' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Introduction à propos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "À PROPOS DE NEXORA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "À propos de Nexora"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Nexora est une plateforme d’investissement participatif qui connecte les entrepreneurs visionnaires avec des investisseurs comme vous.</p><p>Notre mission : rendre l’investissement dans l’innovation accessible à tous, dès 100 €.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Introduction à propos"
    }
  ]
}
{% endschema %}
