<section class="section about-intro">
  <div class="container about-intro__grid">
    <div class="about-intro__content reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="richtext">{{ section.settings.text }}</div>
    </div>
    <div class="about-intro__visual reveal reveal--delay">
      {% render 'project-visual', image: section.settings.image, loading: 'lazy' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Introduction à propos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "À PROPOS DE NEXORA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Investir dans ce qui construit demain."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Nexora connecte les investisseurs à des entreprises ambitieuses qui développent les technologies, services et infrastructures du futur.</p><p>Notre objectif est de rendre l'accès aux opportunités plus simple, plus transparent et plus humain.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Introduction à propos"
    }
  ]
}
{% endschema %}
