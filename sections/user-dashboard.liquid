{% comment %}Dashboard: logged-in customers only, showing the products they purchased.{% endcomment %}

{% if customer %}
  {% assign purchased_count = 0 %}
  {% assign total_spent = 0 %}
  {% for order in customer.orders %}
    {% assign purchased_count = purchased_count | plus: 1 %}
    {% assign total_spent = total_spent | plus: order.total_price %}
  {% endfor %}

  <section class="nx-project-view nx-pv-dashboard-page" data-user-dashboard>
    <div class="nx-project-view__shell">
      <div class="nx-pv-panel nx-pv-dashboard">
        <header class="nx-pv-topbar">
          <a href="{{ routes.root_url }}" class="nx-pv-brand" aria-label="Nexora">
            <span class="nx-pv-brand__mark">N</span>
            <span>NEXORA</span>
          </a>
          <a href="{{ routes.account_url }}">My account</a>
        </header>

        <div class="nx-pv-dashboard-body">
          <div class="nx-pv-greeting">
            <strong>Hello, {{ customer.first_name | default: customer.name }} 👋</strong>
            <p>
              {{ purchased_count }} {% if purchased_count == 1 %}purchase{% else %}purchases{% endif %}
              &middot; {{ total_spent | money_without_trailing_zeros }} invested
            </p>
          </div>

          <div class="nx-pv-section-heading">
            <strong>My purchases</strong>
            <a href="{{ routes.collections_url }}/projects">Browse projects</a>
          </div>

          {% if purchased_count > 0 %}
            <div class="nx-pv-list">
              {% for order in customer.orders %}
                {% for line in order.line_items %}
                  <a href="{{ line.product.url }}" class="nx-pv-list-item">
                    <div class="nx-pv-list-thumb">
                      {% render 'project-visual', image: line.product.featured_image, loading: 'lazy' %}
                    </div>
                    <div class="nx-pv-list-copy">
                      <strong>{{ line.title }}</strong>
                      <span>
                        Order {{ order.name }} &middot; {{ order.created_at | date: '%d %b %Y' }}
                        {% if line.quantity > 1 %}&middot; Qty {{ line.quantity }}{% endif %}
                      </span>
                    </div>
                    <div class="nx-pv-list-value">
                      <strong>{{ line.price | times: line.quantity | money_without_trailing_zeros }}</strong>
                    </div>
                    <span class="nx-pv-chevron">›</span>
                  </a>
                {% endfor %}
              {% endfor %}
            </div>
          {% else %}
            <div class="empty-state">
              <p>You haven't made any purchases yet.</p>
              <a class="button" href="{{ routes.collections_url }}/projects">Explore projects</a>
            </div>
          {% endif %}

          <nav class="nx-pv-bottom-nav" aria-label="Account navigation">
            <a href="{{ routes.root_url }}"><span>⌂</span>Home</a>
            <a href="{{ routes.collections_url }}/projects"><span>▣</span>Projects</a>
            <a class="is-active" href="{{ routes.account_url }}"><span>◈</span>My purchases</a>
          </nav>
        </div>
      </div>
    </div>
  </section>
{% else %}
  {% assign login_url = routes.account_login_url | append: '?return_to=' | append: request.path %}
  <meta http-equiv="refresh" content="0; url={{ login_url }}">
  <script>window.location.href = "{{ login_url }}";</script>
  <div class="nx-pv-login-guard">
    <strong>Restricted access</strong>
    <p>Log in to view your purchases.</p>
    <a href="{{ login_url }}">Log in</a>
  </div>
{% endif %}

{% schema %}
{
  "name": "Dashboard",
  "settings": []
}
{% endschema %}
