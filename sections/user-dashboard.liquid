<section class="nx-project-view nx-pv-dashboard-page" data-user-dashboard>
  <div class="nx-project-view__shell">
    <div class="nx-pv-panel nx-pv-dashboard">
      <header class="nx-pv-topbar">
        <a href="{{ routes.root_url }}" class="nx-pv-brand" aria-label="Nexora">
          <span class="nx-pv-brand__mark">N</span>
          <span>NEXORA</span>
        </a>
        <div class="nx-pv-top-actions">
          <button type="button" aria-label="Notifications" class="nx-pv-icon-button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
          </button>
          <button type="button" aria-label="Menu" class="nx-pv-icon-button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h14"/></svg>
          </button>
        </div>
      </header>
      <div class="nx-pv-dashboard-body">
        <div class="nx-pv-greeting">
          <strong>Bonjour, {{ customer.first_name | default: customer.name }} 👋</strong>
          <span>{{ section.settings.greeting }}</span>
          <p>{{ section.settings.greeting_subtitle }}</p>
        </div>

        {% assign total_spent = 0 %}
        {% assign order_count = 0 %}
        {% if customer %}
          {% for order in customer.orders %}
            {% assign total_spent = total_spent | plus: order.total_price %}
            {% assign order_count = order_count | plus: 1 %}
          {% endfor %}
        {% endif %}

        <div class="nx-pv-portfolio-card">
          <div>
            <span>VALEUR TOTALE DU PORTEFEUILLE</span>
            <strong>{{ total_spent | money_without_trailing_zeros }}</strong>
          </div>
          <div class="nx-pv-portfolio-glow" aria-hidden="true">N</div>
        </div>

        {% assign next_payment_date = '' %}
        {% assign next_payment_days = '' %}
        {% if customer %}
          {% assign now_ts = 'now' | date: '%s' %}
          {% for order in customer.orders %}
            {% assign order_ts = order.created_at | date: '%s' %}
            {% if order_ts > now_ts %}
              {% if next_payment_date == '' %}
                {% assign next_payment_date = order.created_at | date: '%-d %B %Y' %}
                {% assign diff_seconds = order_ts | minus: now_ts %}
                {% assign next_payment_days = diff_seconds | divided_by: 86400 %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}

        <div class="nx-pv-metric-grid">
          <div class="nx-pv-metric"><span>Revenus mensuels</span><strong>{{ section.settings.monthly_income }}</strong><i>↗</i></div>
          <div class="nx-pv-metric"><span>Total investi</span><strong>{{ total_spent | money_without_trailing_zeros }}</strong><small>{{ order_count }} {% if order_count > 1 %}projets{% else %}projet{% endif %}</small><i>▣</i></div>
          <div class="nx-pv-metric"><span>Prochain versement</span><strong>{% if next_payment_date != '' %}{{ next_payment_date }}{% else %}-{% endif %}</strong><small>{% if next_payment_days != '' %}Dans {{ next_payment_days }} jour{% if next_payment_days > 1 %}s{% endif %}{% else %}Aucun{% endif %}</small><i>▣</i></div>
          <div class="nx-pv-metric"><span>Projets actifs</span><strong>{{ order_count }}</strong><small>{{ order_count }} {% if order_count > 1 %}projets{% else %}projet{% endif %}</small><i>◔</i></div>
        </div>

        <div class="nx-pv-section-heading"><strong>Revenus mensuels</strong><a href="{{ routes.collections_url }}/projects">Voir tout</a></div>
        {% assign chart_total_feb = 0 %}
        {% assign chart_total_mar = 0 %}
        {% assign chart_total_apr = 0 %}
        {% assign chart_total_may = 0 %}
        {% assign chart_total_jun = 0 %}
        {% assign chart_total_jul = 0 %}
        {% assign chart_total_aug = 0 %}
        {% if customer %}
          {% for order in customer.orders %}
            {% assign order_month = order.created_at | date: "%m" %}
            {% if order_month == "02" %}{% assign chart_total_feb = chart_total_feb | plus: order.total_price %}{% endif %}
            {% if order_month == "03" %}{% assign chart_total_mar = chart_total_mar | plus: order.total_price %}{% endif %}
            {% if order_month == "04" %}{% assign chart_total_apr = chart_total_apr | plus: order.total_price %}{% endif %}
            {% if order_month == "05" %}{% assign chart_total_may = chart_total_may | plus: order.total_price %}{% endif %}
            {% if order_month == "06" %}{% assign chart_total_jun = chart_total_jun | plus: order.total_price %}{% endif %}
            {% if order_month == "07" %}{% assign chart_total_jul = chart_total_jul | plus: order.total_price %}{% endif %}
            {% if order_month == "08" %}{% assign chart_total_aug = chart_total_aug | plus: order.total_price %}{% endif %}
          {% endfor %}
        {% endif %}
        {% assign chart_max = chart_total_feb %}
        {% if chart_total_mar > chart_max %}{% assign chart_max = chart_total_mar %}{% endif %}
        {% if chart_total_apr > chart_max %}{% assign chart_max = chart_total_apr %}{% endif %}
        {% if chart_total_may > chart_max %}{% assign chart_max = chart_total_may %}{% endif %}
        {% if chart_total_jun > chart_max %}{% assign chart_max = chart_total_jun %}{% endif %}
        {% if chart_total_jul > chart_max %}{% assign chart_max = chart_total_jul %}{% endif %}
        {% if chart_total_aug > chart_max %}{% assign chart_max = chart_total_aug %}{% endif %}
        {% if chart_max == 0 %}{% assign chart_max = 1 %}{% endif %}

        {% assign chart_months = 'Fév,Mar,Avr,Mai,Juin,Juil,Août' | split: ',' %}
        {% assign chart_totals = chart_total_feb | append: ',' | append: chart_total_mar | append: ',' | append: chart_total_apr | append: ',' | append: chart_total_may | append: ',' | append: chart_total_jun | append: ',' | append: chart_total_jul | append: ',' | append: chart_total_aug | split: ',' %}

        <div class="nx-pv-chart-card">
          <div class="nx-pv-chart-meta"><strong>{{ total_spent | money_without_trailing_zeros }}</strong></div>
          <div class="nx-pv-chart" aria-label="Graphique des revenus mensuels">
            {% for total in chart_totals %}
              {% assign pct = total | times: 100 | divided_by: chart_max %}
              {% if pct < 5 and total > 0 %}{% assign pct = 5 %}{% endif %}
              {% if total == 0 %}{% assign pct = 0 %}{% endif %}
              <div class="nx-pv-bar-wrap">
                <span class="nx-pv-bar" style="height: {{ pct }}%;"></span>
                <small>{{ chart_months[forloop.index0] }}</small>
              </div>
            {% endfor %}
            <b class="nx-pv-chart-bubble">{{ total_spent | money_without_trailing_zeros }}</b>
          </div>
        </div>

        <div class="nx-pv-section-heading"><strong>Mes investissements</strong><a href="{{ routes.collections_url }}/projects">Voir tout</a></div>
        <div class="nx-pv-list">
          {% assign projects_collection = collections.projects %}
          {% if projects_collection.products_count > 0 %}
            {% for investment in projects_collection.products limit: 5 %}
              {% assign investment_current = investment.metafields.project.total_purchases.value | default: 0 %}
              {% assign investment_category = investment.metafields.project.category.value | default: 'Technologie' %}
              <a href="{{ investment.url }}?view=view-project" class="nx-pv-list-item">
                <div class="nx-pv-list-thumb">{% render 'project-visual', image: investment.featured_image, loading: 'lazy' %}</div>
                <div class="nx-pv-list-copy"><strong>{{ investment.title }}</strong><span>{{ investment_category }}</span></div>
                <div class="nx-pv-list-value"><strong>€{{ section.settings.default_share_count }}</strong><span>{{ investment_current | money_without_trailing_zeros }}</span><em class="nx-pv-positive">+{{ section.settings.default_growth }}</em></div>
                <span class="nx-pv-chevron">›</span>
              </a>
            {% endfor %}
          {% else %}
            <a href="{{ routes.collections_url }}/projects" class="nx-pv-list-item">
              <div class="nx-pv-list-thumb"></div>
              <div class="nx-pv-list-copy"><strong>Aucun investissement</strong><span>Découvrez nos projets</span></div>
              <span class="nx-pv-chevron">›</span>
            </a>
          {% endif %}
        </div>

        <nav class="nx-pv-bottom-nav" aria-label="Navigation du compte">
          <a href="{{ routes.root_url }}"><span>⌂</span>Accueil</a>
          <a href="{{ routes.collections_url }}/projects"><span>▣</span>Projets</a>
          <a class="is-active" href="{{ routes.account_url }}"><span>◈</span>Investissements</a>
          <a href="{{ routes.account_url }}"><span>◯</span>Profil</a>
        </nav>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tableau de bord",
  "settings": [
    { "type": "text", "id": "user_name", "label": "Nom utilisateur", "default": "Bonjour, Alex 👋" },
    { "type": "text", "id": "greeting", "label": "Salutation", "default": "Bienvenue" },
    { "type": "text", "id": "greeting_subtitle", "label": "Sous-titre", "default": "Voici un aperçu de vos investissements." },
    { "type": "text", "id": "portfolio_value", "label": "Valeur portefeuille", "default": "€ 4 600" },
    { "type": "text", "id": "portfolio_growth", "label": "Croissance portefeuille", "default": "+12.4% depuis le début" },
    { "type": "text", "id": "monthly_income", "label": "Revenus mensuels", "default": "-" },
    { "type": "text", "id": "monthly_growth", "label": "Croissance mensuelle", "default": "6.8%" },
    { "type": "text", "id": "total_invested", "label": "Total investi", "default": "€2 345" },
    { "type": "text", "id": "invested_count", "label": "Nombre d'investissements", "default": "5 projets" },
    { "type": "text", "id": "next_payment", "label": "Prochain versement", "default": "5 Août 2025" },
    { "type": "text", "id": "next_payment_subtitle", "label": "Sous-titre prochain versement", "default": "Dans 5 jours" },
    { "type": "text", "id": "active_projects", "label": "Projets actifs", "default": "46" },
    { "type": "text", "id": "total_projects", "label": "Total projets", "default": "50" },
    { "type": "text", "id": "chart_value", "label": "Valeur graphique", "default": "€185" },
    { "type": "text", "id": "chart_growth", "label": "Croissance graphique", "default": "+6.8%" },
    { "type": "text", "id": "chart_peak", "label": "Pic graphique", "default": "185" },
    { "type": "text", "id": "default_share_count", "label": "Parts par défaut", "default": "10" },
    { "type": "text", "id": "default_growth", "label": "Croissance par défaut", "default": "3.6%" }
  ]
}
{% endschema %}
