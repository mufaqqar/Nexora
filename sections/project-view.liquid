{% assign current_amount = product.metafields.project.total_purchases.value | default: 0 %}
{% assign target_amount = product.metafields.project.target_amount.value | default: 1 %}
{% assign category = product.metafields.project.category.value | default: '' %}
{% assign share_price = product.selected_or_first_available_variant.price | default: 0 %}
{% assign share_price_decimal = share_price | divided_by: 100.0 %}
{% assign remaining_shares = product.metafields.project.remaining_shares.value | default: 100 %}
{% assign monthly_return = product.metafields.project.monthly_return.value | default: '' %}
{% assign platform_fee = section.settings.platform_fee | default: 2 %}

<section class="nx-project-view" data-project-view>
  <div class="nx-project-view__shell">
      <article class="nx-pv-panel nx-pv-sell">
        <header class="nx-pv-sell-header">
          <a href="{{ product.url }}" class="nx-pv-back" aria-label="Retour">←</a>
          <strong>Investir</strong>
          <button type="button" class="nx-pv-help" aria-label="Aide">?</button>
        </header>

        <div class="nx-pv-sell-body">
          <div class="nx-pv-product-mini">
            <div class="nx-pv-product-mini__image">{% render 'project-visual', image: product.featured_image, loading: 'eager' %}</div>
            <div class="nx-pv-product-mini__copy">
              <strong>{{ product.title }}</strong>
              <span>{{ category }}</span>
              <small>{{ remaining_shares }} parts</small>
            </div>
            <div class="nx-pv-product-mini__return"><strong>{{ monthly_return }}</strong><span>par mois</span></div>
          </div>

       <div class="nx-pv-step">

  <div class="nx-pv-step-title">
    <strong>1. Combien de parts voulez-vous investir ?</strong>
    <span>Disponibles : {{ remaining_shares }} parts</span>
  </div>

  <div class="nx-pv-quantity">

    <!-- Minus -->
    <button
      type="button"
      data-qty-minus
      aria-label="Diminuer"
      class="nx-pv-qty-btn"
    >
      −
    </button>

    <!-- Quantity -->
    <div class="nx-pv-qty-value">
      <input
        type="number"
        value="1"
        min="1"
        max="{{ remaining_shares }}"
        data-share-quantity
        aria-label="Nombre de parts"
      >
    </div>

    <!-- Plus -->
    <button
      type="button"
      data-qty-plus
      aria-label="Augmenter"
      class="nx-pv-qty-btn"
    >
      +
    </button>

  </div>

  <!-- Slider -->
  <div class="nx-pv-range">
    <input
      type="range"
      min="1"
      max="{{ remaining_shares }}"
      value="1"
      data-share-range
      aria-label="Nombre de parts"
    >
  </div>

  <!-- Range labels -->
  <div class="nx-pv-range-labels">
    <span>1</span>
    <span>{{ remaining_shares }}</span>
  </div>

</div>

          <div class="nx-pv-step">
            <div class="nx-pv-step-title"><strong>2. Prix par part</strong><span>Prix du produit : {{ share_price | money_without_trailing_zeros }}</span></div>
            <label class="nx-pv-price-input"><span>€</span><input type="number" value="{{ share_price_decimal }}" min="1" step="0.01" data-share-price aria-label="Prix par part" readonly></label>
          </div>

          <div class="nx-pv-step nx-pv-summary">
            <strong class="nx-pv-step-heading">3. Récapitulatif de votre investissement</strong>
            <div class="nx-pv-summary-row"><span>Nombre de parts</span><strong><b data-summary-quantity>5</b> parts</strong></div>
            <div class="nx-pv-summary-row"><span>Prix par part</span><strong>€<b data-summary-price>{{ share_price_decimal }}</b></strong></div>
            <div class="nx-pv-summary-row"><span>Valeur totale</span><strong>€<b data-summary-total>675</b></strong></div>
            <div class="nx-pv-summary-row nx-pv-summary-row--fee"><span>Frais de plateforme ({{ platform_fee }}%)</span><strong>-€<b data-summary-fee>13.50</b></strong></div>
            <div class="nx-pv-summary-total"><span>Total à payer</span><strong>€<b data-summary-net>661.50</b></strong></div>
          </div>

          <div class="nx-pv-important">
            <strong>Informations importantes</strong>
            <ul>
              <li>Votre investissement sera ajouté au panier.</li>
              <li>Vous restez propriétaire de vos parts une fois la transaction effectuée.</li>
              <li>Les frais sont indiqués lors du paiement.</li>
            </ul>
          </div>

          <button type="button" class="nx-pv-list-button" data-list-sale>🛒&nbsp; Ajouter au panier</button>
          <button type="button" class="nx-pv-cancel" data-cancel-sale>Annuler</button>

          <div class="nx-pv-section-heading nx-pv-announcements-heading"><strong>Mes investissements</strong><a href="{{ routes.collections_url }}/projects">Voir toutes</a></div>
          <div class="nx-pv-list nx-pv-announcements">
            {% assign announcement_products = collections.projects.products %}
            {% if announcement_products.size > 0 %}
              {% for announcement in announcement_products limit: 3 %}
                <a href="{{ announcement.url }}?view=view-project" class="nx-pv-list-item nx-pv-list-item--announcement">
                  <div class="nx-pv-list-thumb">{% render 'project-visual', image: announcement.featured_image, loading: 'lazy' %}</div>
                  <div class="nx-pv-list-copy"><strong>{{ announcement.title }}</strong><span>{{ section.settings.default_share_count }} parts à {{ share_price | money_without_trailing_zeros }}</span></div>
                  <span class="nx-pv-status nx-pv-status--{{ forloop.index }}">{{ section.settings.default_status }}</span>
                  <span class="nx-pv-chevron">›</span>
                </a>
              {% endfor %}
            {% else %}
              <a href="{{ product.url }}?view=view-project" class="nx-pv-list-item nx-pv-list-item--announcement">
                <div class="nx-pv-list-thumb">{% render 'project-visual', image: product.featured_image, loading: 'lazy' %}</div>
                <div class="nx-pv-list-copy"><strong>{{ product.title }}</strong><span>5 parts à €{{ share_price_decimal }}</span></div>
                <span class="nx-pv-status">En attente</span><span class="nx-pv-chevron">›</span>
              </a>
            {% endif %}
          </div>
        </div>
      </article>
  </div>
</section>

<script>
(function () {

  var root = document.querySelector('[data-project-view]');

  if (!root) return;

  var qty = root.querySelector('[data-share-quantity]');
  var range = root.querySelector('[data-share-range]');
  var price = root.querySelector('[data-share-price]');
  var minusBtn = root.querySelector('[data-qty-minus]');
  var plusBtn = root.querySelector('[data-qty-plus]');

  if (!qty || !range || !price || !minusBtn || !plusBtn) return;

  var max = Number(qty.max || 12);
  var min = Number(qty.min || 1);

  var feeRate = Number({{ platform_fee | json }}) / 100;


  /* =====================================================
     UPDATE SLIDER PROGRESS
  ===================================================== */

  function updateRangeProgress(value) {

    var rangeMin = Number(range.min || 1);
    var rangeMax = Number(range.max || max);

    if (rangeMax <= rangeMin) {
      range.style.setProperty('--range-progress', '0%');
      return;
    }

    var percentage =
      ((Number(value) - rangeMin) /
      (rangeMax - rangeMin)) * 100;

    percentage = Math.max(0, Math.min(100, percentage));

    range.style.setProperty(
      '--range-progress',
      percentage + '%'
    );
  }


  /* =====================================================
     MAIN UPDATE
  ===================================================== */

  function update() {

    var q = Number(qty.value) || min;

    q = Math.max(
      min,
      Math.min(max, q)
    );

    var p = Number(price.value) || 1;

    p = Math.max(1, p);


    /* Quantity */

    qty.value = q;
    range.value = q;


    /* Slider */

    updateRangeProgress(q);


    /* Buttons */

    minusBtn.disabled = q <= min;
    plusBtn.disabled = q >= max;


    /* Calculations */

    var total = q * p;
    var fee = total * feeRate;
    var net = total - fee;


    /* Summary */

    var summaryQuantity =
      root.querySelector('[data-summary-quantity]');

    var summaryPrice =
      root.querySelector('[data-summary-price]');

    var summaryTotal =
      root.querySelector('[data-summary-total]');

    var summaryFee =
      root.querySelector('[data-summary-fee]');

    var summaryNet =
      root.querySelector('[data-summary-net]');


    if (summaryQuantity) {
      summaryQuantity.textContent = q;
    }

    if (summaryPrice) {
      summaryPrice.textContent = p.toFixed(2);
    }

    if (summaryTotal) {
      summaryTotal.textContent = total.toFixed(2);
    }

    if (summaryFee) {
      summaryFee.textContent = fee.toFixed(2);
    }

    if (summaryNet) {
      summaryNet.textContent = net.toFixed(2);
    }

  }


  /* =====================================================
     CHANGE QUANTITY
  ===================================================== */

  function changeQty(delta) {

    var current =
      Number(qty.value) || min;

    var newValue =
      current + delta;

    newValue = Math.max(
      min,
      Math.min(max, newValue)
    );

    qty.value = newValue;

    update();
  }


  /* =====================================================
     MINUS
  ===================================================== */

  minusBtn.addEventListener(
    'click',
    function (e) {

      e.preventDefault();

      changeQty(-1);

    }
  );


  /* =====================================================
     PLUS
  ===================================================== */

  plusBtn.addEventListener(
    'click',
    function (e) {

      e.preventDefault();

      changeQty(1);

    }
  );


  /* =====================================================
     NUMBER INPUT
  ===================================================== */

  qty.addEventListener(
    'input',
    function () {

      var value =
        Number(qty.value) || min;

      value = Math.max(
        min,
        Math.min(max, value)
      );

      range.value = value;

      updateRangeProgress(value);

    }
  );


  qty.addEventListener(
    'change',
    function () {

      update();

    }
  );


  /* =====================================================
     RANGE SLIDER
  ===================================================== */

  range.addEventListener(
    'input',
    function () {

      var value =
        Number(range.value) || min;

      qty.value = value;

      updateRangeProgress(value);

      /* Update calculations immediately */
      update();

    }
  );


  /* =====================================================
     PRICE
  ===================================================== */

  price.addEventListener(
    'input',
    function () {

      update();

    }
  );


  /* =====================================================
     ADD TO CART
  ===================================================== */

  var addButton =
    root.querySelector('[data-list-sale]');

  if (addButton) {

    addButton.addEventListener(
      'click',
      function () {

        var q =
          Math.max(
            min,
            Number(qty.value) || min
          );

        var self = this;

        self.disabled = true;

        fetch('{{ routes.cart_add_url }}', {

          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({

            id: {{ product.selected_or_first_available_variant.id | json }},

            quantity: q

          })

        })
        .then(function (res) {

          if (!res.ok) {
            throw new Error('error');
          }

          self.textContent =
            '✓ Ajouté au panier';

          self.classList.add(
            'is-success'
          );


          var cartLink =
            document.createElement('a');

          cartLink.href =
            '{{ routes.cart_url }}';

          cartLink.className =
            'nx-pv-list-button';

          cartLink.textContent =
            'Voir le panier →';


          self.replaceWith(cartLink);

        })
        .catch(function () {

          self.disabled = false;

        });

      }
    );

  }


  /* =====================================================
     CANCEL
  ===================================================== */

  var cancelButton =
    root.querySelector('[data-cancel-sale]');

  if (cancelButton) {

    cancelButton.addEventListener(
      'click',
      function () {

        window.location.href =
          '{{ product.url }}';

      }
    );

  }


  /* =====================================================
     INITIAL STATE
  ===================================================== */

  update();

})();
</script>
{% schema %}
{
  "name": "Vue projet / vente",
  "settings": [
    { "type": "text", "id": "user_name", "label": "Nom utilisateur", "default": "Bonjour, Alex 👋" },
    { "type": "text", "id": "greeting", "label": "Salutation", "default": "Bienvenue" },
    { "type": "text", "id": "greeting_subtitle", "label": "Sous-titre", "default": "Voici un aperçu de vos investissements." },
    { "type": "text", "id": "portfolio_value", "label": "Valeur portefeuille", "default": "€ 4 600" },
    { "type": "text", "id": "portfolio_growth", "label": "Croissance portefeuille", "default": "+12.4% depuis le début" },
    { "type": "text", "id": "monthly_income", "label": "Revenus mensuels", "default": "€185" },
    { "type": "text", "id": "monthly_growth", "label": "Croissance mensuelle", "default": "6.8%" },
    { "type": "text", "id": "total_invested", "label": "Total investi", "default": "€2 345" },
    { "type": "text", "id": "invested_count", "label": "Nombre d'investissements", "default": "5 projets" },
    { "type": "text", "id": "next_payment", "label": "Prochain versement", "default": "5 Août 2025" },
    { "type": "text", "id": "next_payment_subtitle", "label": "Sous-titre prochain versement", "default": "Dans 5 jours" },
    { "type": "text", "id": "active_projects", "label": "Projets actifs", "default": "46" },
    { "type": "text", "id": "total_projects", "label": "Total projets", "default": "50" },
    { "type": "text", "id": "chart_value", "label": "Valeur graphique", "default": "€185" },
    { "type": "text", "id": "chart_growth", "label": "Croissance graphique", "default": "+6.8%" },
    { "type": "text", "id": "chart_peak", "label": "Pic graphique", "default": "185" },
    { "type": "text", "id": "default_share_count", "label": "Parts par défaut", "default": "10" },
    { "type": "text", "id": "default_growth", "label": "Croissance par défaut", "default": "3.6%" },
    { "type": "text", "id": "default_status", "label": "Statut annonce", "default": "En attente" },
    { "type": "number", "id": "platform_fee", "label": "Frais de plateforme (%)", "default": 2 }
  ]
}
{% endschema %}
