{% assign current_amount = product.metafields.project.total_purchases.value | default: 0 %}
{% assign target_amount = product.metafields.project.target_amount.value | default: 1 %}
{% assign category = product.metafields.project.category.value | default: '' %}
{% assign share_price = product.selected_or_first_available_variant.price | default: 0 %}
{% assign share_price_decimal = share_price | divided_by: 100.0 %}
{% assign remaining_shares = product.metafields.project.remaining_shares.value | default: 100 %}
{% assign monthly_return = product.metafields.project.monthly_return.value | default: '' %}
{% assign platform_fee = section.settings.platform_fee | default: 2 %}

<section class="nx-project-view" data-project-view>
  <div class="nx-project-view__shell">
      <article class="nx-pv-panel nx-pv-sell">
        <header class="nx-pv-sell-header">
          <a href="{{ product.url }}" class="nx-pv-back" aria-label="Back">←</a>
          <strong>Invest</strong>
          
        </header>

        <div class="nx-pv-sell-body">
          <div class="nx-pv-product-mini none">
            <div class="nx-pv-product-mini__image">{% render 'project-visual', image: product.featured_image, loading: 'eager' %}</div>
            <div class="nx-pv-product-mini__copy">
              <strong>{{ product.title }}</strong>
              <span>{{ category }}</span>
           
            </div>
            <div class="nx-pv-product-mini__return"><strong>{{ monthly_return }}</strong></div>
          </div>

       <div class="nx-pv-step">

  <div class="nx-pv-step-title">
    <strong>1. How many shares would you like to invest in?</strong>
  
  </div>

  <div class="nx-pv-quantity">

    <!-- Minus -->
    <button
      type="button"
      data-qty-minus
      aria-label="Decrease"
      class="nx-pv-qty-btn"
    >
      −
    </button>

    <!-- Quantity -->
    <div class="nx-pv-qty-value">
      <input
        type="number"
        value="1"
        min="1"
        max="{{ remaining_shares }}"
        data-share-quantity
        aria-label="Number of shares"
      >
    </div>

    <!-- Plus -->
    <button
      type="button"
      data-qty-plus
      aria-label="Increase"
      class="nx-pv-qty-btn"
    >
      +
    </button>

  </div>

  <!-- Slider -->
  <div class="nx-pv-range">
    <input
      type="range"
      min="1"
      max="{{ remaining_shares }}"
      value="1"
      data-share-range
      aria-label="Number of shares"
    >
  </div>

  <!-- Range labels -->
  <div class="nx-pv-range-labels">
    <span>1</span>
    <span>12</span>
  </div>

</div>

          <div class="nx-pv-step">
            <div class="nx-pv-step-title"><strong>2. Price per share</strong><span>Product price: 100</span></div>
            <label class="nx-pv-price-input"><span>€</span><input type="number" value="100" min="1" step="0.01" data-share-price aria-label="Price per share" readonly></label>
          </div>

          <div class="nx-pv-step nx-pv-summary">
            <strong class="nx-pv-step-heading">3. Sale summary</strong>
          
            <div class="nx-pv-summary-row"><span>Price per share:</span><strong>€<b data-summary-price>12</b></strong></div>
            <div class="nx-pv-summary-row"><span>Total value:</span><strong>€<b data-summary-total>675</b></strong></div>
            <div class="nx-pv-summary-row nx-pv-summary-row--fee"><span>Platform fee ({{ platform_fee }}%)</span><strong>+€<b data-summary-fee>13.50</b></strong></div>
            <div class="nx-pv-summary-total"><span>You pay</span><strong>€<b data-summary-net>661.50</b></strong></div>
          </div>

          <div class="nx-pv-important">
            <strong>Important information</strong>
            <ul>
              <li> Your investment will be added to your cart.</li>
              <li> You retain ownership of your shares once the transaction is complete.</li>
              <li> Fees are shown at checkout.</li>
            </ul>
          </div>

          <button type="button" class="nx-pv-list-button" data-list-sale> Buy</button>
          <button type="button" class="nx-pv-cancel" data-cancel-sale>Cancel</button>

         
        </div>
      </article>
  </div>
</section>

<script>
(function () {

  var root = document.querySelector('[data-project-view]');

  if (!root) return;

  var qty = root.querySelector('[data-share-quantity]');
  var range = root.querySelector('[data-share-range]');
  var price = root.querySelector('[data-share-price]');
  var minusBtn = root.querySelector('[data-qty-minus]');
  var plusBtn = root.querySelector('[data-qty-plus]');

  if (!qty || !range || !price || !minusBtn || !plusBtn) return;

  var max = Number(qty.max || 12);
  var min = Number(qty.min || 1);

  var feeRate = Number({{ platform_fee | json }}) / 100;


  /* =====================================================
     UPDATE SLIDER PROGRESS
  ===================================================== */

  function updateRangeProgress(value) {

    var rangeMin = Number(range.min || 1);
    var rangeMax = Number(range.max || max);

    if (rangeMax <= rangeMin) {
      range.style.setProperty('--range-progress', '0%');
      return;
    }

    var percentage =
      ((Number(value) - rangeMin) /
      (rangeMax - rangeMin)) * 100;

    percentage = Math.max(0, Math.min(100, percentage));

    range.style.setProperty(
      '--range-progress',
      percentage + '%'
    );
  }


  /* =====================================================
     MAIN UPDATE
  ===================================================== */

  function update() {

    var q = Number(qty.value) || min;

    q = Math.max(
      min,
      Math.min(max, q)
    );

    var p = Number(price.value) || 1;

    p = Math.max(1, p);


    /* Quantity */

    qty.value = q;
    range.value = q;


    /* Slider */

    updateRangeProgress(q);


    /* Buttons */

    minusBtn.disabled = q <= min;
    plusBtn.disabled = q >= max;


    /* Calculations */

    var total = q * p;
    var fee = total * feeRate;
    var net = total + fee;


    /* Summary */

    var summaryQuantity =
      root.querySelector('[data-summary-quantity]');

    var summaryPrice =
      root.querySelector('[data-summary-price]');

    var summaryTotal =
      root.querySelector('[data-summary-total]');

    var summaryFee =
      root.querySelector('[data-summary-fee]');

    var summaryNet =
      root.querySelector('[data-summary-net]');


    if (summaryQuantity) {
      summaryQuantity.textContent = q;
    }

    if (summaryPrice) {
      summaryPrice.textContent = p.toFixed(2);
    }

    if (summaryTotal) {
      summaryTotal.textContent = total.toFixed(2);
    }

    if (summaryFee) {
      summaryFee.textContent = fee.toFixed(2);
    }

    if (summaryNet) {
      summaryNet.textContent = net.toFixed(2);
    }

  }


  /* =====================================================
     CHANGE QUANTITY
  ===================================================== */

  function changeQty(delta) {

    var current =
      Number(qty.value) || min;

    var newValue =
      current + delta;

    newValue = Math.max(
      min,
      Math.min(max, newValue)
    );

    qty.value = newValue;

    update();
  }


  /* =====================================================
     MINUS
  ===================================================== */

  minusBtn.addEventListener(
    'click',
    function (e) {

      e.preventDefault();

      changeQty(-1);

    }
  );


  /* =====================================================
     PLUS
  ===================================================== */

  plusBtn.addEventListener(
    'click',
    function (e) {

      e.preventDefault();

      changeQty(1);

    }
  );


  /* =====================================================
     NUMBER INPUT
  ===================================================== */

  qty.addEventListener(
    'input',
    function () {

      var value =
        Number(qty.value) || min;

      value = Math.max(
        min,
        Math.min(max, value)
      );

      range.value = value;

      updateRangeProgress(value);

    }
  );


  qty.addEventListener(
    'change',
    function () {

      update();

    }
  );


  /* =====================================================
     RANGE SLIDER
  ===================================================== */

  range.addEventListener(
    'input',
    function () {

      var value =
        Number(range.value) || min;

      qty.value = value;

      updateRangeProgress(value);

      /* Update calculations immediately */
      update();

    }
  );


  /* =====================================================
     PRICE
  ===================================================== */

  price.addEventListener(
    'input',
    function () {

      update();

    }
  );


  /* =====================================================
     ADD TO CART
  ===================================================== */

  var addButton =
    root.querySelector('[data-list-sale]');

  if (addButton) {

    addButton.addEventListener(
      'click',
      function () {

        var q =
          Math.max(
            min,
            Number(qty.value) || min
          );

        var self = this;

        self.disabled = true;

        fetch('{{ routes.cart_add_url }}', {

          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({

            id: {{ product.selected_or_first_available_variant.id | json }},

            quantity: q

          })

        })
        .then(function (res) {

          if (!res.ok) {
            throw new Error('error');
          }

          window.location.href =
            '{{ routes.cart_url }}';

        })
        .catch(function () {

          self.disabled = false;

        });

      }
    );

  }


  /* =====================================================
     CANCEL
  ===================================================== */

  var cancelButton =
    root.querySelector('[data-cancel-sale]');

  if (cancelButton) {

    cancelButton.addEventListener(
      'click',
      function () {

        window.location.href =
          '{{ product.url }}';

      }
    );

  }


  /* =====================================================
     INITIAL STATE
  ===================================================== */

  update();

})();
</script>
{% schema %}
{
  "name": "Project view / sale",
  "settings": [
    { "type": "text", "id": "user_name", "label": "User name", "default": "Hello, Alex 👋" },
    { "type": "text", "id": "greeting", "label": "Greeting", "default": "Welcome" },
    { "type": "text", "id": "greeting_subtitle", "label": "Subtitle", "default": "Here's an overview of your investments." },
    { "type": "text", "id": "portfolio_value", "label": "Portfolio value", "default": "€4,600" },
    { "type": "text", "id": "portfolio_growth", "label": "Portfolio growth", "default": "+12.4% since the beginning" },
    { "type": "text", "id": "monthly_income", "label": "Monthly income", "default": "€185" },
    { "type": "text", "id": "monthly_growth", "label": "Monthly growth", "default": "0" },
    { "type": "text", "id": "total_invested", "label": "Total invested", "default": "€2,345" },
    { "type": "text", "id": "invested_count", "label": "Number of investments", "default": "5 projects" },
    { "type": "text", "id": "next_payment", "label": "Next payout", "default": "5 Aug 2025" },
    { "type": "text", "id": "next_payment_subtitle", "label": "Next payout subtitle", "default": "In 5 days" },
    { "type": "text", "id": "active_projects", "label": "Active projects", "default": "46" },
    { "type": "text", "id": "total_projects", "label": "Total projects", "default": "50" },
    { "type": "text", "id": "chart_value", "label": "Chart value", "default": "€185" },
    { "type": "text", "id": "chart_growth", "label": "Chart growth", "default": "0" },
    { "type": "text", "id": "chart_peak", "label": "Chart peak", "default": "185" },
    { "type": "text", "id": "default_share_count", "label": "Default shares", "default": "10" },
    { "type": "text", "id": "default_growth", "label": "Default growth", "default": "3.6%" },
    { "type": "text", "id": "default_status", "label": "Listing status", "default": "Pending" },
    { "type": "number", "id": "platform_fee", "label": "Platform fee (%)", "default": 2 }
  ]
}
{% endschema %}
