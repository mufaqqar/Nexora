<header class="site-header" data-header>
  <div class="container site-header__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            loading: 'eager',
            widths: '150,200,300,400',
            sizes: '200px',
            class: 'site-header__logo-image',
            alt: shop.name
        }}
      {% else %}
        {% render 'logo' %}
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navigation principale">
      <a href="{{ routes.root_url }}">Accueil</a>
      <a href="{{ routes.collections_url }}/projects">Projets</a>
      <a href="{{ pages['about'].url | default: '/pages/about' }}">À propos</a>
    </nav>

    <!-- Header Actions -->
    <div class="site-header__actions">
      <a class="login-link" href="/account">
        Se connecter
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="MobileNav"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        {% render 'icon-menu' %}
      </button>
    </div>
<a class="login-icon" href="/account">
  <svg
    class="account-icon"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="12"
      cy="8"
      r="3"
      stroke="currentColor"
      stroke-width="1.5"
    />

    <path
      d="M5 20C5.8 16.5 8.1 14.5 12 14.5C15.9 14.5 18.2 16.5 19 20"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  </svg>
</a>
  </div>

  <!-- Mobile Navigation -->
  <div id="MobileNav" class="mobile-nav" data-mobile-nav>
    <div class="mobile-nav__inner container">
      <a href="{{ routes.root_url }}">Accueil</a>
      <a href="{{ routes.collections_url }}/projects">Projets</a>
      <a href="{{ pages['about'].url | default: '/pages/about' }}">À propos</a>
      <a href="/account">Se connecter</a>
    </div>
  </div>
</header>


{% schema %}
{
  "name": "En-tête Nexora",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ],
  "presets": [
    {
      "name": "En-tête Nexora"
    }
  ]
}
{% endschema %}