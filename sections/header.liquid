<header class="site-header" data-header>
  <div class="container site-header__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag:
            loading: 'eager',
            widths: '150,200,300,400',
            sizes: '200px',
            class: 'site-header__logo-image',
            alt: shop.name
        }}
      {% else %}
        {% render 'logo' %}
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}/projects">Projects</a>
      <a href="{{ pages['about'].url | default: '/pages/about' }}">About</a>
      <a href="/account">Dashboard</a>
    </nav>

    <!-- Header Actions -->
    <div class="site-header__actions">
      <a class="login-link" href="/account">
        Log in
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="MobileNav"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__icon menu-toggle__icon--open">{% render 'icon-menu' %}</span>
        <span class="menu-toggle__icon menu-toggle__icon--close">{% render 'icon-close' %}</span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="MobileNav" class="mobile-nav" data-mobile-nav>
    <div class="mobile-nav__inner container">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.collections_url }}/projects">Projects</a>
      <a href="{{ pages['about'].url | default: '/pages/about' }}">About</a>
      <a href="/account">Dashboard</a>
      <a href="/account">Log in</a>

      {%- comment -%}
        Language switcher slot.
        The Uplinkly Language Translate widget is moved here on mobile by nexora.js.
        It can also be targeted directly from the app settings with the selector
        [data-language-switcher] (position: end).
      {%- endcomment -%}
      <div class="mobile-nav__language" data-language-switcher></div>
    </div>
  </div>
</header>


{% schema %}
{
  "name": "Nexora header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the default logo.png from theme assets."
    }
  ],
  "presets": [
    {
      "name": "Nexora header"
    }
  ]
}
{% endschema %}