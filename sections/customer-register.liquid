<section class="customer-page">
  <div class="customer-shell">

    <div class="customer-card customer-card--register">

      <div class="customer-brand">
        {% render 'logo' %}
      </div>

      <p class="customer-welcome">
        Create an account
      </p>

      <p class="customer-subtitle">
        Join Nexora and discover curated opportunities.
      </p>


      {% form 'create_customer', class: 'customer-form' %}

        {{ form.errors | default_errors }}


        <!-- Name -->

        <div class="customer-field">

          <label for="RegisterFirstName">
            First name
          </label>

          <input
            id="RegisterFirstName"
            type="text"
            name="customer[first_name]"
            autocomplete="given-name"
            placeholder="John"
            required
          >

        </div>

        <!-- Last Name -->

        <div class="customer-field">

          <label for="RegisterLastName">
            Last name
          </label>

          <input
            id="RegisterLastName"
            type="text"
            name="customer[last_name]"
            autocomplete="family-name"
            placeholder="Smith"
            required
          >

        </div>


        <!-- Email -->

        <div class="customer-field">

          <label for="RegisterEmail">
            Email
          </label>

          <input
            id="RegisterEmail"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="john@example.com"
            required
          >

        </div>

        <!-- Phone -->

        <div class="customer-field">

          <label for="RegisterPhone">
            Phone
          </label>

          <input
            id="RegisterPhone"
            type="tel"
            name="customer[phone]"
            autocomplete="tel"
            placeholder="+1 555 123 4567"
          >

        </div>

        <!-- Company -->

        <div class="customer-field">

          <label for="RegisterCompany">
            Company
          </label>

          <input
            id="RegisterCompany"
            type="text"
            name="customer[note]"
            placeholder="Your company name"
          >

        </div>


        <!-- Password -->

        <div class="customer-field">

          <label for="RegisterPassword">
            Password
          </label>

          <div class="customer-password">

            <input
              id="RegisterPassword"
              type="password"
              name="customer[password]"
              autocomplete="new-password"
              placeholder="••••••••"
              required
            >

            <button
              type="button"
              class="password-toggle"
              data-password-toggle
              data-target="RegisterPassword"
              aria-label="Show password"
            >
              ◉
            </button>

          </div>

        </div>


        <!-- Terms -->

        <label class="checkbox-label checkbox-label--terms">

          <input
            type="checkbox"
            required
          >

          <span>

            I agree to the

            <a href="/policies/terms-of-service">
              Terms of Use
            </a>

            and the

            <a href="/policies/privacy-policy">
              Privacy Policy
            </a>.

          </span>

        </label>


        <button
          class="customer-submit"
          type="submit"
        >
          Create account
        </button>

      {% endform %}


      <div class="customer-divider">
        <span>OR</span>
      </div>


      <!-- Social buttons -->

      <div class="customer-social">

        <button
          type="button"
          class="social-button"
          aria-label="Continue with Google"
        >
          G
        </button>

        <button
          type="button"
          class="social-button"
          aria-label="Continue with Apple"
        >
          ●
        </button>

      </div>


      <p class="customer-bottom">

        Already have an account?

        <a href="{{ routes.account_login_url }}">
          Log in
        </a>

      </p>

    </div>

  </div>
</section>


{% schema %}

{
  "name": "Account creation",
  "settings": []
}

{% endschema %}