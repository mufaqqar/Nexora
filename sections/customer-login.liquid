<section class="customer-page">
  <div class="customer-shell">

    <div class="customer-card customer-card--login">

      <div class="customer-brand">
        {% render 'logo' %}
      </div>

      <p class="customer-welcome">Welcome back!</p>

      <p class="customer-subtitle">
        Log in to access your Nexora account.
      </p>

      {% form 'customer_login', class: 'customer-form' %}

        {{ form.errors | default_errors }}

        <div class="customer-field">
          <label for="CustomerEmail">
            Email
          </label>

          <input
            id="CustomerEmail"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="john@example.com"
            required
          >
        </div>

        <div class="customer-field">

          <label for="CustomerPassword">
            Password
          </label>

          <div class="customer-password">

            <input
              id="CustomerPassword"
              type="password"
              name="customer[password]"
              autocomplete="current-password"
              placeholder="••••••••"
              required
            >

            <button
              type="button"
              class="password-toggle"
              data-password-toggle
              data-target="CustomerPassword"
              aria-label="Show password"
            >
              ◉
            </button>

          </div>

        </div>

        <div class="customer-options">

          <label class="checkbox-label">

            <input
              type="checkbox"
              name="remember_me"
              value="1"
            >

            <span>
              Remember me
            </span>

          </label>

          <a
            href="#recover"
            data-recover-toggle
          >
            Forgot your password?
          </a>

        </div>

        <button
          class="customer-submit"
          type="submit"
        >
          Log in
        </button>

      {% endform %}

      <div class="customer-divider">
        <span>OR</span>
      </div>

      <div class="customer-social">

        <button
          type="button"
          class="social-button"
          aria-label="Continue with Google"
        >
          G
        </button>

        <button
          type="button"
          class="social-button"
          aria-label="Continue with Apple"
        >
          ●
        </button>

      </div>

      <p class="customer-bottom">

        Don't have an account?

        <a href="{{ routes.account_register_url }}">
          Create an account
        </a>

      </p>


      <!-- Password recovery -->

      {% form 'recover_customer_password',
        class: 'recover-form',
        id: 'recover'
      %}

        <h2>
          Reset your password
        </h2>

        <p>
          Enter your email and we'll send you
          a recovery link.
        </p>

        {{ form.errors | default_errors }}

        {% if form.posted_successfully? %}

          <p class="customer-success">
            A recovery email has been sent.
          </p>

        {% endif %}

        <div class="customer-field">

          <label for="RecoverEmail">
            Email
          </label>

          <input
            id="RecoverEmail"
            type="email"
            name="email"
            autocomplete="email"
            required
          >

        </div>

        <button
          class="customer-submit"
          type="submit"
        >
          Send link
        </button>

        <button
          class="recover-cancel"
          type="button"
          data-recover-toggle
        >
          Cancel
        </button>

      {% endform %}

    </div>

  </div>
</section>


{% schema %}

{
  "name": "Customer login",
  "settings": []
}

{% endschema %}