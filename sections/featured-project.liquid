{% assign featured = section.settings.product %}

<section class="section section--projects">
  <div class="container">

    <!-- SECTION HEADING -->
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        <a
          class="text-link"
          href="{{ routes.collections_url }}/projects"
        >
          {{ section.settings.link_label }}
          {% render 'icon-arrow' %}
        </a>
      {% endif %}
    </div>


    <!-- FEATURED PROJECT -->
    {% if featured != blank %}

      {% assign feat_current = featured.metafields.project.total_purchases.value | default: 0 %}
      {% assign feat_target = featured.metafields.project.target_amount.value | default: 1 %}
      {% assign feat_funded = feat_current | times: 100 | divided_by: feat_target %}
      {% assign feat_customers = featured.metafields.project.customers.value | default: 0 %}

      <div class="featured-project">

        <!-- LEFT IMAGE -->
        <div class="featured-project__image">

          {% if featured.featured_image != blank %}
            {{
              featured.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '500,700,900,1200',
                sizes: '(min-width: 990px) 40vw, 100vw',
                class: 'featured-project__image-element',
                alt: featured.featured_image.alt | default: featured.title
            }}
          {% endif %}

          {% if section.settings.category != blank %}
            <div class="featured-project__category">
              {{ section.settings.category }}
            </div>
          {% endif %}

        </div>


        <!-- RIGHT CONTENT -->
        <div class="featured-project__content">

          <div class="featured-project__header">

            <h3>
              {{ featured.title }}
            </h3>

            {% if section.settings.description != blank %}
              <p class="featured-project__description">
                {{ section.settings.description }}
              </p>
            {% endif %}

          </div>


          <!-- STATS -->
          <div class="featured-project__stats">

            <div class="featured-project__stat featured-project__stat--highlight">
              <strong>{{ feat_funded }}%</strong>
              <span>Financé</span>
            </div>

            <div class="featured-project__stat">
              <strong>{{ feat_current | money_without_trailing_zeros }}</strong>
              <span>Total achats / {{ feat_target | money_without_trailing_zeros }}</span>
            </div>

            <div class="featured-project__stat">
              <strong>{{ feat_customers }}</strong>
              <span>Clients</span>
            </div>

          </div>


          <!-- PROGRESS -->
          <div class="featured-project__progress">

            <div class="featured-project__progress-bar">
              <span
                style="width: {{ feat_funded }}%;"
              ></span>
            </div>

            <div class="featured-project__progress-labels">
              <span>0%</span>
              <span>100%</span>
            </div>

          </div>


          <!-- ACTION BUTTONS -->
          <div class="featured-project__actions">

            <a
              href="{{ featured.url }}?view=view-project"
              class="featured-project__button featured-project__button--secondary"
            >
              Voir le projet
            </a>

            <a
              href="{{ featured.url }}"
              class="featured-project__button featured-project__button--primary"
            >
              Investir dès {{ section.settings.minimum }} €
              {% render 'icon-arrow' %}
            </a>

          </div>

        </div>

      </div>

    {% else %}

      {% assign fallback = collections['projects'].products.first %}

      {% if fallback != blank %}

        <div class="featured-project">

          <div class="featured-project__image">
            {{
              fallback.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '500,700,900,1200',
                sizes: '(min-width: 990px) 40vw, 100vw',
                class: 'featured-project__image-element',
                alt: fallback.featured_image.alt | default: fallback.title
            }}
          </div>

          <div class="featured-project__content">

            <h3>{{ fallback.title }}</h3>

            {% if section.settings.description != blank %}
              <p class="featured-project__description">
                {{ section.settings.description }}
              </p>
            {% endif %}

          </div>

        </div>

      {% else %}

        <div class="empty-state">
          <p>
            Ajoutez un produit à la collection « projects »
            pour afficher votre premier projet.
          </p>
        </div>

      {% endif %}

    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Projet mis en avant",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "PROJETS EN COURS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Des opportunités sélectionnées."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Lien",
      "default": "Investir dès 100 €"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Projet"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Catégorie",
      "default": "Résidentiel & Pro"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Système d'alarme intelligent pour maisons et entreprises"
    },
    {
      "type": "number",
      "id": "minimum",
      "label": "Investissement minimum",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Projet mis en avant"
    }
  ]
}
{% endschema %}