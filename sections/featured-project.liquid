{% assign featured = section.settings.product %}

<section class="section section--projects">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <a class="text-link" href="{{ routes.collections_url }}/projects">
        {{ section.settings.link_label }}
        {% render 'icon-arrow' %}
      </a>
    </div>

    {% if featured != blank %}
      {% render 'project-card', product: featured %}
    {% else %}
      {% assign fallback = collections['projects'].products.first %}
      {% if fallback != blank %}
        {% render 'project-card', product: fallback %}
      {% else %}
        <div class="empty-state">
          <p>Ajoutez un produit à la collection « projects » pour afficher votre premier projet.</p>
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Projet mis en avant",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "PROJETS EN COURS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Des opportunités sélectionnées."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Lien",
      "default": "Tous les projets"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Projet"
    }
  ],
  "presets": [
    {
      "name": "Projet mis en avant"
    }
  ]
}
{% endschema %}
