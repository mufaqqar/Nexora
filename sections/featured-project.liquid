<section class="section section--projects">
  <div class="container">

    <!-- SECTION HEADING -->
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank %}
        <a
          class="text-link"
          href="{{ routes.collections_url }}/projects"
        >
          {{ section.settings.link_label }}
          {% render 'icon-arrow' %}
        </a>
      {% endif %}
    </div>

    <!-- SLIDER -->
    {% assign all_projects = collections['projects'].products %}

    {% if all_projects.size > 0 %}
      <div class="featured-projects-slider" data-featured-slider>

        <div class="featured-projects-slider__track" data-slider-track>
          {% for product in all_projects %}

            {% assign feat_current = product.metafields.project.total_purchases.value | default: 0 %}
            {% assign feat_target = product.metafields.project.target_amount.value | default: 1 %}
            {% assign feat_funded = feat_current | times: 100 | divided_by: feat_target %}
            {% assign feat_customers = product.metafields.project.customers.value | default: 0 %}
            {% assign feat_category = product.metafields.project.category.value | default: 'Technologie' %}

            <div class="featured-projects-slider__slide">
              <div class="featured-project">

                <div class="featured-project__image">
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '500,700,900,1200',
                        sizes: '(min-width: 990px) 40vw, 100vw',
                        class: 'featured-project__image-element',
                        alt: product.featured_image.alt | default: product.title
                    }}
                  {% endif %}

                  <div class="featured-project__category">
                    {{ feat_category }}
                  </div>
                </div>

                <div class="featured-project__content">

                  <div class="featured-project__header">
                    <h3>{{ product.title }}</h3>
                    {% if product.description != blank %}
                      <p class="featured-project__description">
                        {{ product.description | strip_html }}
                      </p>
                    {% endif %}
                  </div>

                  <div class="featured-project__stats">
                    <div class="featured-project__stat featured-project__stat--highlight">
                      <strong>{{ feat_funded }}%</strong>
                      <span>Financé</span>
                    </div>
                    <div class="featured-project__stat">
                      <strong>{{ feat_current | money_without_trailing_zeros }}</strong>
                      <span>Total achats / {{ feat_target | money_without_trailing_zeros }}</span>
                    </div>
                    <div class="featured-project__stat">
                      <strong>{{ feat_customers }}</strong>
                      <span>Clients</span>
                    </div>
                  </div>

                  <div class="featured-project__progress">
                    <div class="featured-project__progress-bar">
                      <span style="width: {{ feat_funded }}%;"></span>
                    </div>
                    <div class="featured-project__progress-labels">
                      <span>0%</span>
                      <span>100%</span>
                    </div>
                  </div>

                  <div class="featured-project__actions">
                    <a
                      href="{{ product.url }}"
                      class="featured-project__button featured-project__button--secondary"
                    >
                      Voir le projet
                    </a>
                  </div>

                </div>

              </div>
            </div>

          {% endfor %}
        </div>

        <div class="featured-projects-slider__dots" data-slider-dots>
          {% for product in all_projects %}
            <button
              class="featured-projects-slider__dot{% if forloop.first %} is-active{% endif %}"
              data-slider-dot="{{ forloop.index0 }}"
              aria-label="Slide {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>

      </div>
    {% else %}

      <div class="empty-state">
        <p>
          Ajoutez des projets à la collection « projects »
          pour afficher votre slider.
        </p>
      </div>

    {% endif %}

  </div>
</section>


{% schema %}
{
  "name": "Slider projets",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "PROJETS EN COURS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Des opportunités sélectionnées."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Lien",
      "default": "Tous les projets"
    }
  ],
  "presets": [
    {
      "name": "Slider projets"
    }
  ]
}
{% endschema %}
