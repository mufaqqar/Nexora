<section class="how-it-works">
  <div class="how-it-works__container">

    <!-- LEFT CONTENT -->
    <div class="how-it-works__content">

      <h2 class="how-it-works__heading">
        {{ section.settings.heading }}
      </h2>

      <p class="how-it-works__intro">
        {{ section.settings.intro }}
      </p>

      <div class="how-it-works__steps">

        {% for block in section.blocks %}
          <div
            class="how-it-works__step"
            {{ block.shopify_attributes }}
          >

            <!-- ICON -->
            <div class="how-it-works__icon">

              {% case block.settings.icon %}

                {% when 'search' %}

                  <svg viewBox="0 0 48 48" fill="none">
                    <circle
                      cx="21"
                      cy="21"
                      r="10"
                      stroke="currentColor"
                      stroke-width="2"
                    />
                    <path
                      d="M29 29L37 37"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>

                {% when 'coins' %}

                  <svg viewBox="0 0 48 48" fill="none">
                    <ellipse
                      cx="18"
                      cy="17"
                      rx="11"
                      ry="5"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M7 17V23C7 25.8 11.9 28 18 28C24.1 28 29 25.8 29 23V17"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <ellipse
                      cx="29"
                      cy="26"
                      rx="11"
                      ry="5"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M18 28V33C18 35.8 22.9 38 29 38C35.1 38 40 35.8 40 33V26"
                      stroke="currentColor"
                      stroke-width="2"
                    />
                  </svg>

                {% when 'chart' %}

                  <svg viewBox="0 0 48 48" fill="none">
                    <path
                      d="M8 37V10"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />

                    <path
                      d="M8 37H40"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />

                    <path
                      d="M13 30L20 23L26 27L38 13"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                {% when 'shield' %}

                  <svg viewBox="0 0 48 48" fill="none">
                    <path
                      d="M24 6L38 11V21C38 30.5 32.3 37 24 41C15.7 37 10 30.5 10 21V11L24 6Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linejoin="round"
                    />

                    <path
                      d="M18 23L22 27L31 18"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

              {% endcase %}

            </div>

            <!-- TEXT -->
            <div class="how-it-works__step-content">

              <h3 class="how-it-works__step-title">
                {{ block.settings.number }}. {{ block.settings.title }}
              </h3>

              <p class="how-it-works__step-text">
                {{ block.settings.text }}
              </p>

            </div>

          </div>
        {% endfor %}

      </div>

    </div>


    <!-- RIGHT IMAGE -->
    <div class="how-it-works__visual">

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'how-it-works__image',
            loading: 'lazy',
            alt: section.settings.heading
        }}

      {% endif %}

    </div>

  </div>
</section>


{% schema %}
{
  "name": "How It Works",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comment ça fonctionne ?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Investir avec Nexora, c’est simple et sécurisé."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image"
    }
  ],

  "blocks": [
    {
      "type": "step",
      "name": "Step",

      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",

          "options": [
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "coins",
              "label": "Coins"
            },
            {
              "value": "chart",
              "label": "Chart"
            },
            {
              "value": "shield",
              "label": "Shield"
            }
          ],

          "default": "search"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Découvrez des projets"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Explorez des projets innovants sélectionnés par notre équipe d'experts."
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "How It Works",

      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "1",
            "icon": "search",
            "title": "Découvrez des projets",
            "text": "Explorez des projets innovants sélectionnés par notre équipe d'experts."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "icon": "coins",
            "title": "Investissez dès 100 €",
            "text": "Choisissez le montant que vous souhaitez investir en toute sécurité."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "3",
            "icon": "chart",
            "title": "Suivez vos investissements",
            "text": "Suivez en temps réel la performance de vos projets."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "4",
            "icon": "shield",
            "title": "Recevez vos gains",
            "text": "Recevez des dividendes selon la performance des projets dans lesquels vous avez investi."
          }
        }
      ]
    }
  ]
}
{% endschema %}