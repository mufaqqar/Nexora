{% assign current = product.metafields.project.total_purchases.value | default: 0 %}
{% assign target_raw = product.metafields.custom.funding_goal | default: product.metafields.project.funding_goal | default: product.metafields.project.target_amount %}
{% if target_raw.value != blank %}
  {% assign target = target_raw.value %}
{% elsif target_raw != blank %}
  {% assign target = target_raw %}
{% else %}
  {% assign target = 1 %}
{% endif %}
{% assign target = target | replace: ',', '' | replace: ' ', '' | replace: '.', '' | plus: 0 %}
{% if target == 5 %}{% assign target = 5000000 %}{% endif %}
{% if target < 1000000 %}{% assign target = target | times: 1000000 %}{% endif %}
{% if target == 0 %}{% assign target = 1 %}{% endif %}
{% assign funded = current | times: 100 | divided_by: target %}
{% assign customers = product.metafields.project.customers.value | default: 0 %}
{% assign category = product.metafields.project.category.value | default: 'Technologie & IA' %}
{% assign minimum = product.metafields.project.investment_minimum.value | default: 100 %}

<section class="section project-detail project-detail--figma">
  <div class="container project-detail__container">

    <a class="figma-back-link" href="{{ routes.collections_url }}/projects">
      <span aria-hidden="true">←</span> Retour aux projets
    </a>

    <div class="figma-detail-hero">
            <div class="figma-detail-visual">
        {% if product.media and product.media.size > 1 %}
          <div class="product-gallery" data-product-gallery>
            <div class="product-gallery__main">
              <div class="product-gallery__track" data-gallery-track>
                {% for media in product.media %}
                  <div class="product-gallery__slide" data-gallery-slide>
                    {% case media.media_type %}
                      {% when 'image' %}
                        {% if forloop.first %}
                          {{ media | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 990px) 40vw, 100vw', class: 'product-gallery__image', alt: media.alt | escape }}
                        {% else %}
                          {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 990px) 40vw, 100vw', class: 'product-gallery__image', alt: media.alt | escape }}
                        {% endif %}
                      {% when 'video' %}
                        {{ media | video_tag: controls: true, class: 'product-gallery__video' }}
                      {% when 'external_video' %}
                        {{ media | external_video_tag: class: 'product-gallery__video' }}
                      {% when 'model' %}
                        {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'product-gallery__model' }}
                      {% else %}
                        {{ media | media_tag: class: 'product-gallery__media' }}
                    {% endcase %}
                  </div>
                {% endfor %}
              </div>
              <button class="product-gallery__nav product-gallery__nav--prev" data-gallery-prev aria-label="Image précédente">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <button class="product-gallery__nav product-gallery__nav--next" data-gallery-next aria-label="Image suivante">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            <div class="product-gallery__thumbs" data-gallery-thumbs>
              {% for media in product.media %}
                <button class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="Aller à l'image {{ forloop.index }}">
                  {% case media.media_type %}
                    {% when 'image' %}
                      {{ media | image_url: width: 150 | image_tag: loading: 'lazy', widths: '80,150', class: 'product-gallery__thumb-image', alt: media.alt | escape }}
                    {% when 'video' %}
                      {{ media.preview_image | image_url: width: 150 | image_tag: loading: 'lazy', widths: '80,150', class: 'product-gallery__thumb-image', alt: media.alt | escape }}
                    {% when 'external_video' %}
                      {{ media.preview_image | image_url: width: 150 | image_tag: loading: 'lazy', widths: '80,150', class: 'product-gallery__thumb-image', alt: media.alt | escape }}
                    {% else %}
                      {{ media.preview_image | default: media | image_url: width: 150 | image_tag: loading: 'lazy', widths: '80,150', class: 'product-gallery__thumb-image', alt: media.alt | escape }}
                  {% endcase %}
                </button>
              {% endfor %}
            </div>
          </div>
        {% elsif product.media and product.media.size == 1 %}
          {% assign media = product.media.first %}
          {% case media.media_type %}
            {% when 'image' %}
              {{ media | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,800,1000,1200,1400', sizes: '(min-width: 990px) 40vw, 100vw', class: 'product-gallery__single', alt: media.alt | escape }}
            {% when 'video' %}
              {{ media | video_tag: controls: true, class: 'product-gallery__single' }}
            {% when 'external_video' %}
              {{ media | external_video_tag: class: 'product-gallery__single' }}
            {% when 'model' %}
              {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, class: 'product-gallery__single' }}
            {% else %}
              {{ media | media_tag: class: 'product-gallery__single' }}
          {% endcase %}
        {% else %}
          {% render 'project-visual', image: product.featured_image, loading: 'eager' %}
        {% endif %}
      </div>

      <div class="figma-detail-summary">
        <h1>{{ product.title }}</h1>
        <p class="figma-detail-lead">{{ product.description | strip_html | truncate: 180 }}</p>

        <span class="figma-category">{{ category }}</span>

        <div class="figma-stats">
          <div class="figma-stat figma-stat--purple">
            <strong>{{ funded }}%</strong>
            <span>Financé</span>
          </div>
          
          <div class="figma-stat">
            <strong>
              {% if target >= 1000000 %}
                {% assign m = target | divided_by: 1000000.0 %}
                {% assign m_int = m | round %}
                {% if m_int == 5 %}$5M{% elsif m_int == 1 %}$1M{% else %}${{ m_int }}M{% endif %}
              {% else %}
                {{ target | money_without_trailing_zeros }}
              {% endif %}
            </strong>
            <span> Total achats</span>
          </div>
          <div class="figma-stat">
            <strong>{{ current | money_without_trailing_zeros }}</strong>
            <span>Clients</span>
          </div>
        </div>

        <div class="figma-progress">
          <div class="figma-progress__bar">
            <span style="width: {{ funded }}%;"></span>
          </div>
          <div class="figma-progress__labels">
            <span>0%</span>
            <span>100%</span>
          </div>
        </div>

        <a class="figma-primary-button" href="?view=view-project">
          Investir dès 100 € <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="figma-about">
      <h2>À propos du projet</h2>
      <div class="figma-about__text">
        {% if product.metafields.project.long_description.value != blank %}
          {{ product.metafields.project.long_description.value }}
        {% else %}
          {{ product.description }}
        {% endif %}
      </div>

      <div class="figma-objective">
        <strong>
          {% if target >= 1000000 %}
            {% assign m = target | divided_by: 1000000.0 %}
            {% assign m_int = m | round %}
            {% if m_int == 5 %}5M{% elsif m_int == 1 %}1M{% else %}{{ m_int }}M{% endif %}
          {% else %}
            {{ target | money_without_trailing_zeros }}
          {% endif %}
        </strong>
        <span>Total achats</span>
      </div>

      <h2>Pourquoi investir ?</h2>
      <ul class="figma-reasons">
        {% assign reasons = product.metafields.project.reasons.value %}
        {% if reasons != blank %}
          {% for reason in reasons %}
            <li>{{ reason }}</li>
          {% endfor %}
        {% else %}
          <li>Marché en forte croissance (+15% par an).</li>
          <li>Équipe expérimentée et vision claire.</li>       
          <li>Partenariats stratégiques déjà en place.</li>
        {% endif %}
      </ul>
    </div>

   

  </div>
</section>

{% schema %}
{
  "name": "Détail projet Figma",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Investir maintenant"
    }
  ]
}
{% endschema %}
