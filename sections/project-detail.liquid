{% assign current = product.metafields.project.current_amount.value | default: 62000 %}
{% assign target = product.metafields.project.target_amount.value | default: 100000 %}
{% assign funded = current | times: 100 | divided_by: target %}
{% assign investors = product.metafields.project.investors.value | default: 34 %}
{% assign category = product.metafields.project.category.value | default: 'Technologie & IA' %}
{% assign minimum = product.metafields.project.investment_minimum.value | default: 100 %}

<section class="section project-detail project-detail--figma">
  <div class="container project-detail__container">

    <a class="figma-back-link" href="{{ routes.collections_url }}/projects">
      <span aria-hidden="true">←</span> Retour aux projets
    </a>

    <div class="figma-detail-hero">
      <div class="figma-detail-visual">
        {% render 'project-visual', image: product.featured_image, loading: 'eager' %}
      </div>

      <div class="figma-detail-summary">
        <h1>{{ product.title }}</h1>
        <p class="figma-detail-lead">{{ product.description | strip_html | truncate: 180 }}</p>

        <span class="figma-category">{{ category }}</span>

        <div class="figma-stats">
          <div class="figma-stat figma-stat--purple">
            <strong>{{ funded }}%</strong>
            <span>Financé</span>
          </div>
          <div class="figma-stat">
            <strong>{{ current | money_without_trailing_zeros }}</strong>
            <span>Sur {{ target | money_without_trailing_zeros }}</span>
          </div>
          <div class="figma-stat">
            <strong>{{ investors }}</strong>
            <span>Investisseurs</span>
          </div>
        </div>

        <div class="figma-progress">
          <div class="figma-progress__bar">
            <span style="width: {{ funded }}%;"></span>
          </div>
          <div class="figma-progress__labels">
            <span>0%</span>
            <span>100%</span>
          </div>
        </div>

        <a class="figma-primary-button" href="#investir">
          Investir dès 100 € <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="figma-about">
      <h2>À propos du projet</h2>
      <div class="figma-about__text">
        {% if product.metafields.project.long_description.value != blank %}
          {{ product.metafields.project.long_description.value }}
        {% else %}
          {{ product.description }}
        {% endif %}
      </div>

      <div class="figma-objective">
        <strong>{{ target | money_without_trailing_zeros }}</strong>
        <span>Objectif</span>
      </div>

      <h2>Pourquoi investir ?</h2>
      <ul class="figma-reasons">
        {% assign reasons = product.metafields.project.reasons.value %}
        {% if reasons != blank %}
          {% for reason in reasons %}
            <li>{{ reason }}</li>
          {% endfor %}
        {% else %}
          <li>Marché en forte croissance (+15% par an).</li>
          <li>Équipe expérimentée et vision claire.</li>
          <li>Produit innovant et éprouvé avec 3 000 utilisateurs.</li>
          <li>Partenariats stratégiques déjà en place.</li>
        {% endif %}
      </ul>
    </div>

    <div class="figma-documents">
      <h2>Documents</h2>
      <div class="figma-documents__grid">
        {% if product.metafields.project.document_1.value != blank %}
          <a class="figma-document" href="{{ product.metafields.project.document_1.value }}" target="_blank" rel="noopener">
            <span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h8l4 4V20H6V3.5Zm8 0V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Pitch deck
            </span>
            <svg class="figma-document__download" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {% else %}
          <span class="figma-document figma-document--empty">
            <span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h8l4 4V20H6V3.5Zm8 0V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Pitch deck
            </span>
            <span class="figma-document__download">↓</span>
          </span>
        {% endif %}

        {% if product.metafields.project.document_2.value != blank %}
          <a class="figma-document" href="{{ product.metafields.project.document_2.value }}" target="_blank" rel="noopener">
            <span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h8l4 4V20H6V3.5Zm8 0V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Business plan
            </span>
            <svg class="figma-document__download" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {% else %}
          <span class="figma-document figma-document--empty">
            <span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h8l4 4V20H6V3.5Zm8 0V8h4M9 12h6M9 15h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Business plan
            </span>
            <span class="figma-document__download">↓</span>
          </span>
        {% endif %}
      </div>
    </div>

    <div class="figma-investment" id="investir">
      <h2>Investir dans ce projet</h2>
      <p class="figma-investment__label">Montant de l'investissement</p>

      {% form 'product', product, class: 'figma-investment__form', id: 'investment-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <div class="figma-amount-input">
          <span>{{ cart.currency.symbol }}</span>
          <input id="InvestmentAmount" type="number" name="quantity" min="1" value="{{ minimum | default: 100 }}" data-investment-amount aria-label="Montant de l'investissement">
        </div>

        <div class="figma-amount-presets" data-amount-presets>
          <button type="button" data-amount="100">100 €</button>
          <button type="button" data-amount="250">250 €</button>
          <button type="button" data-amount="500">500 €</button>
          <button type="button" data-amount="1000">1000 €</button>
        </div>

        <div class="figma-investment__footer">
          <p class="figma-investment__disclaimer">
            <svg xmlns="http://www.w3.org/2000/svg" width="23" height="27" viewBox="0 0 23 27" fill="none">
<path d="M21.1426 5.21582V13.2109C21.1426 17.1526 18.7329 20.0039 16.2256 21.9053C14.9776 22.8517 13.726 23.5456 12.7852 24.0029C12.3156 24.2312 11.9255 24.4 11.6543 24.5107C11.5657 24.5469 11.4894 24.5757 11.4277 24.5996C11.3662 24.5758 11.2902 24.5467 11.2021 24.5107C10.9309 24.4 10.5408 24.2312 10.0713 24.0029C9.13041 23.5456 7.87887 22.8517 6.63086 21.9053C4.1236 20.0039 1.71387 17.1526 1.71387 13.2109V5.21582L11.4277 1.81543L21.1426 5.21582Z" stroke="#8344F4" stroke-width="1.14286"/>
<path d="M1.14258 4.81094V13.2109C1.14258 21.6109 11.4283 25.2109 11.4283 25.2109C11.4283 25.2109 21.714 21.6109 21.714 13.2109V4.81094L11.4283 1.21094L1.14258 4.81094Z" stroke="#8344F4" stroke-width="2.28571" stroke-linecap="square"/>
<path d="M7.05469 12.2646L10.2855 15.4966L16.7507 9.03149" stroke="#8344F4" stroke-width="2.28571" stroke-linecap="square"/>
</svg>
            Paiement sécurisé & fonds protégés
          </p>
          <button class="figma-primary-button figma-primary-button--investment" type="submit">
            {{ section.settings.button_label }} <span aria-hidden="true">→</span>
          </button>
        </div>
      {% endform %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Détail projet Figma",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Bouton",
      "default": "Investir maintenant"
    }
  ]
}
{% endschema %}
