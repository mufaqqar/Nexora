<section class="hero section">
  <div class="container hero__grid">

    <div class="hero__content reveal">

      {% comment %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endcomment %}

      <h1>{{ section.settings.heading }}</h1>
   

      <p class="hero__description">
        {{ section.settings.description }}
      </p>

      {% if section.settings.button_label != blank %}
        <a
          class="button"
          href="{{ section.settings.button_link | default: routes.collections_url }}"
        >
          {{ section.settings.button_label }}
          {% render 'icon-arrow' %}
        </a>
      {% endif %}


      <!-- STATIC ICON BOX -->
      {% if section.settings.icon != blank %}
        <div class="hero__icon-box">

          <div class="hero__icon">
            {{
              section.settings.icon
              | image_url: width: 100
              | image_tag:
                loading: 'lazy',
                widths: '50,75,100',
                sizes: '50px',
                class: 'hero__icon-image',
                alt: section.settings.icon_heading
            }}
          </div>

          <div class="hero__icon-content">
            {% if section.settings.icon_heading != blank %}
              <h3>{{ section.settings.icon_heading }}</h3>
            {% endif %}

            {% if section.settings.icon_text != blank %}
              <p>{{ section.settings.icon_text }}</p>
            {% endif %}
          </div>

        </div>
      {% endif %}
      <div class="cart-payment-methods">
  <p class="cart-payment-methods__title">
    Paiement sécurisé
  </p>

  <div class="cart-payment-methods__icons">
    {{ 'apple_pay' | payment_type_svg_tag }}
    {{ 'google_pay' | payment_type_svg_tag }}
    {{ 'paypal' | payment_type_svg_tag }}
    {{ 'visa' | payment_type_svg_tag }}
    {{ 'master' | payment_type_svg_tag }}
    {{ 'american_express' | payment_type_svg_tag }}
  </div>
</div>
    </div>


    <div class="hero__visual reveal reveal--delay">
      {% render 'project-visual',
        image: section.settings.image,
        loading: 'eager'
      %}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Hero Nexora",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "PLATEFORME D'INVESTISSEMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Investissez dans les entreprises qui construisent le futur."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Accédez à des opportunités sélectionnées et participez à la croissance des entreprises de demain."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte bouton",
      "default": "Découvrir les projets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien bouton"
    },

    {
      "type": "header",
      "content": "Boîte icône"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icône"
    },
    {
      "type": "text",
      "id": "icon_heading",
      "label": "Titre de l'icône",
      "default": "Investissement sécurisé"
    },
    {
      "type": "textarea",
      "id": "icon_text",
      "label": "Texte de l'icône",
      "default": "Vos investissements sont protégés à chaque étape."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image hero"
    }
  ],

  "presets": [
    {
      "name": "Hero Nexora"
    }
  ]
}
{% endschema %}