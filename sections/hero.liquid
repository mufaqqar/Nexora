<section class="hero section">
  <div class="container hero__grid">

    <div class="hero__content reveal">

      {% comment %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endcomment %}

      <h1>{{ section.settings.heading }}</h1>

      <p class="hero__description">
        {{ section.settings.description }}
      </p>

      {% if section.settings.button_label != blank %}
        <a
          class="button"
          href="{{ section.settings.button_link | default: routes.collections_url }}"
        >
          {{ section.settings.button_label }}
          {% render 'icon-arrow' %}
        </a>
      {% endif %}


      <!-- HERO VALUE BLOCKS -->
      {% if section.blocks.size > 0 %}
        <div class="hero__values">

          {% for block in section.blocks %}
            <div
              class="hero__value-item"
              {{ block.shopify_attributes }}
            >

              {% if block.settings.icon != blank %}
                <div class="hero__value-icon">
                  {{
                    block.settings.icon
                    | image_url: width: 100
                    | image_tag:
                      loading: 'lazy',
                      widths: '50,75,100',
                      sizes: '50px',
                      class: 'hero__value-icon-image',
                      alt: block.settings.heading
                  }}
                </div>
              {% endif %}

              <div class="hero__value-content">
                {% if block.settings.heading != blank %}
                  <h3>{{ block.settings.heading }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p>{{ block.settings.text }}</p>
                {% endif %}
              </div>

            </div>
          {% endfor %}

        </div>
      {% endif %}


      {% if section.settings.note != blank %}
        <div class="hero__note">
          <span class="status-dot"></span>
          <span>{{ section.settings.note }}</span>
        </div>
      {% endif %}

    </div>


    <div class="hero__visual reveal reveal--delay">
      {% render 'project-visual',
        image: section.settings.image,
        loading: 'eager'
      %}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Hero Nexora",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "PLATEFORME D'INVESTISSEMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Investissez dans les entreprises qui construisent le futur."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Accédez à des opportunités sélectionnées et participez à la croissance des entreprises de demain."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte bouton",
      "default": "Découvrir les projets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien bouton"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Opportunités sélectionnées avec soin"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image hero"
    }
  ],

  "blocks": [
    {
      "type": "value",
      "name": "Valeur",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icône"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Investissement sécurisé"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "Investissez dans des opportunités sélectionnées avec soin."
        }
      ]
    }
  ],

  "max_blocks": 3,

  "presets": [
    {
      "name": "Hero Nexora",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Investissement sécurisé",
            "text": "Des opportunités sélectionnées avec soin."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Opportunités sélectionnées",
            "text": "Des projets analysés avec une approche rigoureuse."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Suivi transparent",
            "text": "Suivez vos investissements en toute simplicité."
          }
        }
      ]
    }
  ]
}
{% endschema %}