<section class="hero section hero_bg">
  <div class="container hero__grid ">
    <div class="hero__content reveal">
      {% comment %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endcomment %}
      <h1>{{ section.settings.heading }} <span class="accent">{{ section.settings.heading_accent }}</span></h1>  

      <p class="hero__description">
        {{ section.settings.description }}
      </p>

      {% if section.settings.button_label != blank %}
        <a
          class="button"
          href="{{ section.settings.button_link | default: routes.collections_url }}"
        >
          {{ section.settings.button_label }}
          {% render 'icon-arrow' %}
        </a>
      {% endif %}

       {% if section.settings.icon != blank %}
      <div class="hero__icon-box">
        <div class="hero__icon">
          {{
            section.settings.icon
            | image_url: width: 100
            | image_tag:
              loading: 'lazy',
              widths: '50,75,100',
              sizes: '50px',
              class: 'hero__icon-image',
              alt: section.settings.icon_heading
          }}
        </div>

        <div class="hero__icon-content">
          {% if section.settings.icon_heading != blank %}
            <h3>{{ section.settings.icon_heading }}</h3>
          {% endif %}

          {% if section.settings.icon_text != blank %}
            <p>{{ section.settings.icon_text }}</p>
          {% endif %}
        </div>

      </div>
    {% endif %}
    </div>
    <div class="hero__visual reveal reveal--delay">
      {% render 'project-visual',
        image: section.settings.image,
        loading: 'eager'
      %}
    </div>
  </div>
  </section>


{% schema %}
{
  "name": "Hero Nexora",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "INVESTMENT PLATFORM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Invest in companies that are building the future."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent title",
      "default": "the future."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Gain access to select opportunities and help shape the growth of tomorrow's businesses."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn about the project"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Icon box"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "icon_heading",
      "label": "Icon title",
      "default": "Secure and Regulated Platform"
    },
    {
      "type": "textarea",
      "id": "icon_text",
      "label": "Icon text",
      "default": "Your investments are protected"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],

  "presets": [
    {
      "name": "Hero Nexora"
    }
  ]
}
{% endschema %}